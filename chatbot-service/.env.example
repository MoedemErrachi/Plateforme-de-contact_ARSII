# ── ARSII Chatbot Service (FastAPI) ──

# ── Server ──
HOST=0.0.0.0
# Render injecte PORT automatiquement. En local : 8000.
PORT=8000

# ── Backend connection ──
# URL du service backend Render pour les appels outils (export, contacts).
# PRODUCTION : https://arsii-backend.onrender.com
# DÉVELOPPEMENT : http://localhost:5000
MAIN_API_BASE_URL=http://localhost:5000

# ── Security ──
# JWT_SECRET doit être IDENTIQUE au backend (validation HS256 des tokens).
JWT_SECRET=CHANGE_ME

# ── Frontend CORS ──
# PRODUCTION : https://arsii-frontend-l41t2c1sl-errachimoedem34-5070s-projects.vercel.app
# DÉVELOPPEMENT : http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM Providers ──
MISTRAL_API_KEY=your_mistral_key
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key

MISTRAL_MODEL=mistral-small-2603
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ── Session / Limits ──
SESSION_TTL_SECONDS=3600
SESSION_MAX_MESSAGES=10
CHATBOT_RATE_LIMIT=20/minute
MAX_TOOL_ROUNDS=3
