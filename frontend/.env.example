# ── ARSII Frontend (Vite) ──
# Vite dev server port
PORT=3000

# Backend URL for Vite dev proxy (only used in development)
# En production, les rewrites vercel.json redirigent /api/* vers le backend.
VITE_BACKEND_URL="http://localhost:5000"

# Chatbot API URL (for OCR extraction from business cards)
# En production, les rewrites vercel.json redirigent /chatbot-api/* vers le chatbot.
VITE_CHATBOT_API_URL="http://localhost:8000"

# ── PRODUCTION (Vercel) ──
# Aucune variable VITE_ n'est nécessaire en production sur Vercel :
#   - /api/* est redirigé par vercel.json → backend Render
#   - /chatbot-api/* est redirigé par vercel.json → chatbot Render
# Les variables ci-dessus ne sont utilisées QUE par le serveur de dev Vite.
