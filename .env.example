# PostgreSQL Database Connection Configuration
# Provided at runtime for application database access (e.g., connection pooling)
SQL_HOST="localhost"
SQL_DB_NAME="arsii_db"
SQL_USER="arsii_app_user"
SQL_PASSWORD="your_postgres_password"

# PostgreSQL Admin Credentials
# Used for schema migrations and Drizzle Kit administration
SQL_ADMIN_USER="arsii_admin_user"
SQL_ADMIN_PASSWORD="your_admin_password"

# Application Security Credentials
JWT_SECRET="arsii-crm-super-secret-jwt-key-2026"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
CSRF_SECRET="arsii-csrf-protection-secret-2026"
