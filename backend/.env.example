# Connexions PostgreSQL (Supabase). COMPLETER les valeurs ci-dessous.
# Runtime (application) : transaction pooler
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Base shadow pour prisma migrate dev (laisser vide si superuser local)
SHADOW_DATABASE_URL=""

# Supabase (Storage). SUPABASE_SERVICE_ROLE_KEY : clé ADMIN, backend uniquement.
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="GENERATE_ME"

# Sécurité applicative
JWT_SECRET="GENERATE_ME"
CSRF_SECRET="GENERATE_ME"

# Serveur
HOST="0.0.0.0"
PORT=5000

# NODE_ENV : "production" sur Render (active la validation CSRF).
NODE_ENV="development"

# PRODUCTION
# FRONTEND_URL="https://[FRONTEND_URL]"
# CORS_ORIGINS="https://[FRONTEND_URL]"

# DÉVELOPPEMENT (local)
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# SMTP transactionnel
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_app_password"
