# PostgreSQL Database Connection Configuration (Supabase)
#
# DATABASE_URL — connexion utilisée par l'application au RUNTIME (driver adapter
#   dans src/config/prisma.ts). Standard production : TRANSACTION POOLER Supavisor
#   (port 6543, mode transaction, paramètre pgbouncer=true) :
#     postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#   Variante équivalente si sslmode requis :
#     ...:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require
#   (la région figure dans Dashboard Supabase > Project Settings > Database)
#
# DIRECT_URL — connexion directe à la base, utilisée par le CLI Prisma
#   (migrations, introspection) via prisma.config.ts.
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require"
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# SHADOW_DATABASE_URL — base shadow utilisée par `prisma migrate dev` pour
# détecter les dérives de schéma. Laisser vide en local si un superuser est
# disponible (Prisma créera la base shadow lui-même) ; obligatoire sur les
# hébergements managés restreints. Doit pointer vers une base vierge dont
# l'utilisateur possède les droits CREATE/DROP.
SHADOW_DATABASE_URL=""

# Supabase Project Credentials
SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY : clé ADMIN Supabase (contourne la Row Level Security).
# Réservée au BACKEND uniquement — ne JAMAIS l'exposer dans le frontend ou le
# chatbot-service. Utilisée par src/config/supabase.ts (upload Storage).
SUPABASE_SERVICE_ROLE_KEY="GENERATE_ME"

# Application Security Credentials
# Generate with: node -e "const c=require('crypto');console.log('JWT_SECRET='+c.randomBytes(48).toString('hex'));console.log('CSRF_SECRET='+c.randomBytes(48).toString('hex'))"
JWT_SECRET="GENERATE_ME"
# CSRF_SECRET : clé HMAC des tokens CSRF (double-submit cookie signé).
# OBLIGATOIRE en production (NODE_ENV=production) — sans elle, les requêtes
# mutantes sont rejetées avec 503 CSRF_NOT_CONFIGURED.
CSRF_SECRET="GENERATE_ME"
# ENCRYPTION_KEY : retirée (aucun cas d'usage chiffrement at-rest identifié).

# Server Configuration
# Render injecte PORT automatiquement — pas besoin de la définir manuellement.
HOST="0.0.0.0"
PORT=5000

# NODE_ENV : "development" par défaut. En "production", la validation CSRF
# devient active pour toutes les méthodes POST/PUT/DELETE/PATCH (sauf endpoints
# anonymes login / forgot-password / reset-password).
# IMPORTANT : mettre "production" sur Render.
NODE_ENV="development"

# ── PRODUCTION (Render) ──
# Remplacer YOUR_PROJECT par le nom du projet Vercel (ex: arsii-euraxess).
# FRONTEND_URL = lien complet utilisé dans les e-mails (reset-password).
# CORS_ORIGINS = origine(s) autorisée(s) par le middleware CORS.
# FRONTEND_URL="https://YOUR_PROJECT.vercel.app"
# CORS_ORIGINS="https://YOUR_PROJECT.vercel.app"

# ── DÉVELOPPEMENT (local) ──
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Gmail SMTP Configuration (for transactional emails)
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_app_password"
