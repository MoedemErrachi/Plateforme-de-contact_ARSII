datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
  MANAGER
}

enum LogType {
  IMPORT
  EXPORT
}

enum LogFormat {
  CSV
  XLSX
  JSON
}

enum NoteType {
  MEETING
  EMAIL
  CALL
  NOTE
}

enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ResearchCareerStage {
  R1_FIRST_STAGE
  R2_RECOGNIZED
  R3_ESTABLISHED
  R4_LEADING
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  passwordHash     String?
  twoFactorEnabled Boolean           @default(false)
  twoFactorSecret  String?
  googleId         String?           @unique
  avatarUrl        String?
  role             Role              @default(USER)
  logs             ImportExportLog[]
  segments         Segment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Tag {
  id          String         @id @default(uuid())
  name        String         @unique
  color       String         @default("#35B8B2")
  category    String?
  description String?
  contacts    TagOnContact[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Contact {
  id                    String               @id @default(uuid())
  email                 String               @unique
  firstName             String
  lastName              String
  gender                Gender
  countryOfOrigin       String
  city                  String
  phone                 String               @default("")
  affiliation           String
  function              String?
  experience            String?
  facultyDepartment     String?
  researchCareerStage   ResearchCareerStage
  avatarUrl             String?
  isVerified            Boolean              @default(true)
  tags                  TagOnContact[]
  exchangeNotes         ExchangeNote[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model TagOnContact {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model ExchangeNote {
  id             String   @id @default(uuid())
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  date           String
  relativeTime   String?
  title          String
  content        String
  author         String?
  authorInitials String?
  projectName    String?
  type           NoteType @default(NOTE)
  createdAt      DateTime @default(now())
}

model Segment {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?  @default("Filter")
  filters     Json
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportExportLog {
  id           String    @id @default(uuid())
  type         LogType
  format       LogFormat
  fileName     String
  recordCount  Int       @default(0)
  status       String    @default("SUCCESS") // SUCCESS, PARTIAL, FAILED
  errorMessage String?
  performedBy  String?
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
}
